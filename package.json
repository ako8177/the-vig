{
  "name": "the-vig",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "A first-person co-op casino roguelike: gamble a shared bank up to the Collector's quota.",
  "author": "jacksonwalley",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "serve:e2e": "vite --mode e2e --port 5181",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "node e2e/smoke.mjs",
    "screens": "node e2e/screens.mjs",
    "shots": "node e2e/shots.mjs",
    "perf": "node e2e/perf.mjs",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "jsfxr": "1.4.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/three": "0.186.0",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "playwright": "1.48.2",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  },
  "build": {
    "appId": "com.jacksonwalley.thevig",
    "productName": "The Vig",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "The-Vig-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "The-Vig-Portable-${version}.exe"
    }
  }
}
